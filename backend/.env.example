# Copia este archivo como .env para desarrollo local
# En Railway, configura estas variables en el panel de Variables

# URI de conexión a MongoDB Atlas (obligatorio)
MONGO_URI=mongodb+srv://<usuario>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# Clave secreta para firmar los JWT (obligatorio, usa una cadena larga y aleatoria)
JWT_SECRET=cambia_esto_por_una_clave_secreta_muy_larga

# Entorno de ejecución
NODE_ENV=production

# Puerto (Railway lo asigna automáticamente, no es necesario configurarlo)
# PORT=8080
